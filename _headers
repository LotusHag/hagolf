# Headers for the app's own files on app.hagolf.app (Cloudflare static assets read this file; it is not served).
# The meta CSP in index.html cannot say who may frame the page, so frame-ancestors lives here: nobody frames the app,
# which keeps "delete my account" and the rest from being clicked through someone else's page.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), payment=(), usb=()
